# Copy to .env (git-ignored) and fill in. Never commit real secrets.
# Local Postgres from the starter docker-compose.yml:
DATABASE_URL=postgresql+psycopg://au:au_local_only@localhost:5432/au_assignment

# Fernet key(s) used to encrypt PII. Comma-separated list = key rotation
# (first key encrypts, all keys can decrypt). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

# Secret for the HMAC lookup hash of phone numbers (>= 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PII_HMAC_KEY=

# Optional: where the workflow schemas + dispositions.csv live
# (default: ../assignment-a-data/schemas relative to solution/).
# SCHEMAS_DIR=
